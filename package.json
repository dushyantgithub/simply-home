{
    "name": "simply-home",
    "title": "Simply Home",
    "description": "Touch-first Home Assistant kiosk for Linux displays",
    "homepage": "https://github.com/dushyantgithub/simply-home",
    "author": "dushyantgithub",
    "version": "0.1.0",
    "license": "MIT",
    "main": "index.js",
    "scripts": {
